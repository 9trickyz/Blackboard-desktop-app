{
  "name": "blackboard-desktop",
  "productName": "Blackboard",
  "version": "1.0.0",
  "description": "Minimal dark glossy cross-platform blackboard desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.blackboard.desktop",
    "productName": "Blackboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "blackboard",
          "name": "Blackboard Document",
          "description": "Blackboard Drawing Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blackboard",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "keywords": [
    "blackboard",
    "whiteboard",
    "drawing",
    "glossy",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "vite": "^8.3.5",
    "wait-on": "^9.0.4"
  }
}
